</section>

<!-- ── CONTACT ── -->
<section id="contact">
  <div class="section-inner">
    <div class="section-header reveal">
      <span class="section-eyebrow">Contact</span>
      <h2 class="section-title">Send a Raven</h2>
      <div class="divider"></div>
    </div>
    <p class="contact-tagline reveal">Press enquiries, collaborations, or just to say your chickens would survive longer than ours. We're listening.</p>
    <div class="contact-links reveal">
      <a href="mailto:hello@madqueststudio.com.au" class="btn btn-secondary">hello@madqueststudio.com.au</a>
      <a href="https://twitter.com/" target="_blank" class="btn btn-secondary">Twitter / X</a>
      <a href="https://instagram.com/" target="_blank" class="btn btn-secondary">Instagram</a>
    </div>
  </div>
</section>

<!-- ── FOOTER ── -->
<footer>
  <div class="footer-logo">Mad Quest Studio</div>
  <div class="footer-links">
    <a href="https://store.steampowered.com/" target="_blank">Steam</a>
    <a href="https://itch.io/" target="_blank">itch.io</a>
    <a href="mailto:hello@madqueststudio.com.au">Email</a>
  </div>
  <p class="footer-copy">© 2025 Mad Quest Studio · Canberra, Australia</p>
</footer>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
</script>

</body>
</html>
