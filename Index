<!-- ── NAV ── -->
<nav>
  <a href="#" class="nav-logo">MQS</a>
  <ul class="nav-links">
    <li><a href="#about">Studio</a></li>
    <li><a href="#games">Games</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
</nav>

<!-- ── HERO ── -->
