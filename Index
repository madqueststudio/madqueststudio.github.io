<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mad Quest Studio</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;600&family=Crimson+Pro:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink:       #0d0b0a;
      --parchment: #f0e8d5;
      --aged:      #c9b99a;
      --rust:      #b84a1e;
      --ember:     #e8753a;
      --gold:      #c9913d;
      --gold-light:#f0c56e;
      --smoke:     #2a2520;
      --ash:       #4a443c;
    }

    html { scroll-behavior: smooth; }

    body {
      background-color: var(--ink);
      color: var(--parchment);
      font-family: 'Crimson Pro', Georgia, serif;
      font-size: 18px;
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* ── Noise overlay ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events: none;
      z-index: 9999;
      opacity: 0.4;
    }

    /* ── Nav ── */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.2rem 4rem;
      background: linear-gradient(to bottom, rgba(13,11,10,0.97) 0%, transparent 100%);
    }

    .nav-logo {
      font-family: 'Cinzel Decorative', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--gold);
      letter-spacing: 0.05em;
      text-decoration: none;
    }

    .nav-links {
      display: flex;
      gap: 2.5rem;
      list-style: none;
    }

    .nav-links a {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--aged);
      text-decoration: none;
      transition: color 0.2s;
    }

    .nav-links a:hover { color: var(--gold-light); }

    /* ── Hero ── */
    .hero {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      padding: 6rem 2rem 4rem;
      overflow: hidden;
    }

    /* Radial ember glow behind hero */
    .hero::after {
      content: '';
      position: absolute;
      bottom: -10%;
      left: 50%;
      transform: translateX(-50%);
      width: 80vw;
      height: 50vh;
      background: radial-gradient(ellipse at center, rgba(184,74,30,0.18) 0%, transparent 70%);
      pointer-events: none;
    }

    /* Decorative horizontal rule */
    .rune-line {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.8rem;
      opacity: 0;
      animation: fadeUp 0.8s ease forwards 0.2s;
    }

    .rune-line::before,
    .rune-line::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, var(--gold), transparent);
      max-width: 120px;
    }

    .rune-line span {
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      letter-spacing: 0.35em;
      color: var(--gold);
      text-transform: uppercase;
    }

    .hero-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(3.5rem, 10vw, 8rem);
      font-weight: 900;
      line-height: 0.95;
      letter-spacing: -0.01em;
      background: linear-gradient(160deg, var(--gold-light) 0%, var(--gold) 40%, var(--rust) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-bottom: 0.5rem;
      opacity: 0;
      animation: fadeUp 1s ease forwards 0.4s;
    }

    .hero-subtitle {
      font-family: 'Cinzel', serif;
      font-size: clamp(1rem, 2.5vw, 1.4rem);
      letter-spacing: 0.4em;
      text-transform: uppercase;
      color: var(--aged);
      margin-bottom: 2rem;
      opacity: 0;
      animation: fadeUp 1s ease forwards 0.6s;
    }

    .hero-tagline {
      font-size: 1.15rem;
      font-style: italic;
      color: var(--aged);
      max-width: 520px;
      margin: 0 auto 3rem;
      opacity: 0;
      animation: fadeUp 1s ease forwards 0.8s;
    }

    .hero-cta {
      display: flex;
      gap: 1.2rem;
      flex-wrap: wrap;
      justify-content: center;
      opacity: 0;
      animation: fadeUp 1s ease forwards 1s;
    }

    .btn {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.85rem 2.4rem;
      border: 1px solid;
      transition: all 0.25s ease;
      cursor: pointer;
      display: inline-block;
    }

    .btn-primary {
      background: var(--rust);
      border-color: var(--ember);
      color: var(--parchment);
    }

    .btn-primary:hover {
      background: var(--ember);
      box-shadow: 0 0 24px rgba(232,117,58,0.35);
    }

    .btn-secondary {
      background: transparent;
      border-color: var(--ash);
      color: var(--aged);
    }

    .btn-secondary:hover {
      border-color: var(--gold);
      color: var(--gold-light);
    }

    /* Scroll indicator */
    .scroll-hint {
      position: absolute;
      bottom: 2.5rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      opacity: 0;
      animation: fadeIn 1s ease forwards 1.6s;
    }

    .scroll-hint span {
      font-family: 'Cinzel', serif;
      font-size: 0.6rem;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: var(--ash);
    }

    .scroll-hint-arrow {
      width: 1px;
      height: 32px;
      background: linear-gradient(to bottom, var(--ash), transparent);
      animation: scrollPulse 2s ease infinite;
    }

    /* ── Section shared ── */
    section {
      padding: 6rem 2rem;
      position: relative;
    }

    .section-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .section-header {
      margin-bottom: 3.5rem;
      position: relative;
    }

    .section-eyebrow {
      font-family: 'Cinzel', serif;
      font-size: 0.65rem;
      letter-spacing: 0.35em;
      text-transform: uppercase;
      color: var(--rust);
      margin-bottom: 0.6rem;
      display: block;
    }

    .section-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(1.8rem, 4vw, 3rem);
      font-weight: 700;
      color: var(--parchment);
      line-height: 1.15;
    }

    .divider {
      width: 60px;
      height: 2px;
      background: linear-gradient(to right, var(--rust), var(--ember));
      margin-top: 1.2rem;
    }

    /* ── About ── */
    #about {
      background: linear-gradient(to bottom, var(--ink) 0%, var(--smoke) 100%);
    }

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
      align-items: center;
    }

    .about-text p {
      color: var(--aged);
      margin-bottom: 1.2rem;
    }

    .about-text p:first-child { color: var(--parchment); font-size: 1.2rem; }

    .about-sigil {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* SVG sigil / emblem */
    .sigil-svg {
      width: 280px;
      height: 280px;
      opacity: 0.85;
    }

    /* ── Games ── */
    #games {
      background: var(--smoke);
    }

    .games-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 2rem;
    }

    .game-card {
      background: var(--ink);
      border: 1px solid var(--ash);
      position: relative;
      overflow: hidden;
      transition: border-color 0.3s, transform 0.3s;
      cursor: default;
    }

    .game-card:hover {
      border-color: var(--gold);
      transform: translateY(-4px);
    }

    .game-card:hover .card-glow {
      opacity: 1;
    }

    .card-glow {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(201,145,61,0.08) 0%, transparent 60%);
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }

    .game-thumb {
      width: 100%;
      aspect-ratio: 16/9;
      background: var(--smoke);
      position: relative;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Placeholder art using CSS */
    .thumb-cn {
      background: linear-gradient(135deg, #1a1208 0%, #2d1f0a 40%, #1a0e05 100%);
    }

    .thumb-cn .thumb-art {
      font-size: 5rem;
      filter: drop-shadow(0 0 20px rgba(232,117,58,0.6));
      animation: floatIcon 4s ease-in-out infinite;
    }

    .thumb-placeholder {
      background: linear-gradient(135deg, #0a0f1a 0%, #0d1a2d 50%, #050d18 100%);
    }

    .thumb-placeholder .thumb-art {
      font-size: 5rem;
      filter: drop-shadow(0 0 16px rgba(100,140,200,0.5));
      opacity: 0.6;
    }

    .coming-soon-badge {
      position: absolute;
      top: 1rem; right: 1rem;
      background: var(--smoke);
      border: 1px solid var(--ash);
      font-family: 'Cinzel', serif;
      font-size: 0.55rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--ash);
      padding: 0.3rem 0.7rem;
    }

    .game-info {
      padding: 1.5rem 1.8rem 1.8rem;
    }

    .game-platform {
      font-family: 'Cinzel', serif;
      font-size: 0.6rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--rust);
      margin-bottom: 0.5rem;
    }

    .game-title {
      font-family: 'Cinzel Decorative', serif;
      font-size: 1.3rem;
      font-weight: 700;
      color: var(--parchment);
      margin-bottom: 0.3rem;
    }

    .game-subtitle {
      font-family: 'Cinzel', serif;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      color: var(--gold);
      margin-bottom: 0.9rem;
    }

    .game-desc {
      font-size: 0.95rem;
      color: var(--aged);
      line-height: 1.6;
      margin-bottom: 1.4rem;
    }

    .game-links {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .btn-sm {
      font-family: 'Cinzel', serif;
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      text-decoration: none;
      padding: 0.55rem 1.3rem;
      border: 1px solid;
      transition: all 0.2s;
      display: inline-block;
    }

    .btn-sm-steam {
      border-color: var(--rust);
      color: var(--ember);
    }

    .btn-sm-steam:hover {
      background: var(--rust);
      color: var(--parchment);
    }

    .btn-sm-itch {
      border-color: var(--ash);
      color: var(--aged);
    }

    .btn-sm-itch:hover {
      border-color: var(--aged);
      color: var(--parchment);
    }

    .btn-sm-disabled {
      border-color: var(--ash);
      color: var(--ash);
      cursor: not-allowed;
      opacity: 0.5;
    }

    /* ── Contact ── */
    #contact {
      background: linear-gradient(to bottom, var(--smoke) 0%, var(--ink) 100%);
      text-align: center;
    }

    #contact .section-header { text-align: center; }
    #contact .divider { margin: 1.2rem auto 0; }

    .contact-tagline {
      color: var(--aged);
      font-style: italic;
      font-size: 1.1rem;
      max-width: 480px;
      margin: 0 auto 2.5rem;
    }

    .contact-links {
      display: flex;
      gap: 1.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    /* ── Footer ── */
    footer {
      border-top: 1px solid var(--smoke);
      padding: 2.5rem 4rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-logo {
      font-family: 'Cinzel Decorative', serif;
      font-size: 0.9rem;
      color: var(--gold);
    }

    .footer-copy {
      font-size: 0.8rem;
      color: var(--ash);
    }

    .footer-links {
      display: flex;
      gap: 1.5rem;
    }

    .footer-links a {
      font-family: 'Cinzel', serif;
      font-size: 0.6rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ash);
      text-decoration: none;
      transition: color 0.2s;
    }

    .footer-links a:hover { color: var(--aged); }

    /* ── Animations ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    @keyframes floatIcon {
      0%, 100% { transform: translateY(0); }
      50%       { transform: translateY(-10px); }
    }

    @keyframes scrollPulse {
      0%, 100% { opacity: 0.3; transform: scaleY(1); }
      50%       { opacity: 0.8; transform: scaleY(1.15); }
    }

    @keyframes rotateSigil {
      from { transform: rotate(0deg); }
      to   { transform: rotate(360deg); }
    }

    /* Scroll-reveal */
    .reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      nav { padding: 1rem 1.5rem; }
      .nav-links { gap: 1.5rem; }
      .about-grid { grid-template-columns: 1fr; gap: 3rem; }
      .about-sigil { order: -1; }
      .sigil-svg { width: 180px; height: 180px; }
      footer { flex-direction: column; text-align: center; padding: 2rem 1.5rem; }
    }

    @media (max-width: 480px) {
      .nav-links { display: none; }
    }
  </style>
</head>
