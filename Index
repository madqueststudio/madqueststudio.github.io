          <line x1="12" y1="140" x2="268" y2="140" stroke="#c9913d" stroke-width="0.5" opacity="0.2"/>
          <line x1="43" y1="43" x2="237" y2="237" stroke="#c9913d" stroke-width="0.5" opacity="0.2"/>
          <line x1="237" y1="43" x2="43" y2="237" stroke="#c9913d" stroke-width="0.5" opacity="0.2"/>
          <!-- Outer diamond points -->
          <polygon points="140,25 155,125 140,140 125,125" fill="#c9913d" opacity="0.15"/>
          <polygon points="140,255 155,155 140,140 125,155" fill="#c9913d" opacity="0.15"/>
          <polygon points="25,140 125,125 140,140 125,155" fill="#c9913d" opacity="0.15"/>
          <polygon points="255,140 155,125 140,140 155,155" fill="#c9913d" opacity="0.15"/>
          <!-- Central shape -->
          <polygon points="140,80 164,116 200,116 172,138 182,174 140,154 98,174 108,138 80,116 116,116" 
                   stroke="#e8753a" stroke-width="1.5" fill="rgba(184,74,30,0.1)" opacity="0.8"/>
          <!-- Center dot -->
          <circle cx="140" cy="140" r="6" fill="#e8753a" opacity="0.9"/>
          <circle cx="140" cy="140" r="10" stroke="#e8753a" stroke-width="1" fill="none" opacity="0.5"/>
          <!-- Cardinal marks -->
          <rect x="138" y="28" width="4" height="12" fill="#c9913d" opacity="0.6" rx="1"/>
          <rect x="138" y="240" width="4" height="12" fill="#c9913d" opacity="0.6" rx="1"/>
          <rect x="28" y="138" width="12" height="4" fill="#c9913d" opacity="0.6" rx="1"/>
          <rect x="240" y="138" width="12" height="4" fill="#c9913d" opacity="0.6" rx="1"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- ── GAMES ── -->
<section id="games">
  <div class="section-inner">
    <div class="section-header reveal">
      <span class="section-eyebrow">Our Games</span>
      <h2 class="section-title">The Quests So Far</h2>
      <div class="divider"></div>
    </div>

    <div class="games-grid">

      <!-- Game 1: Chicken Nights -->
